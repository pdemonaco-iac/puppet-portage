<%- | Portage::Makeconfig $config | -%>
# This file is managed by Puppet. Local changes will be overwritten.
<% $config.keys.sort.each |$key| { -%>
<%   $separator = $key ? { 'USE_ORDER' => ':', default => ' ' } -%>
<%   $value = $config[$key] ? { Array => join($config[$key], $separator), default => String($config[$key]) } -%>
<%= $key %>="<%= regsubst($value, '"', '\\"', 'G') %>"
<% } -%>
